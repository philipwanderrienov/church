{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend (Go)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/api",
            "cwd": "${workspaceFolder}/backend",
            "serverReadyAction": {
                "pattern": "Server starting on .*:8081",
                "uriFormat": "http://localhost:8081/swagger/index.html",
                "action": "openExternally"
            }
        },
        {
            "name": "Debug Frontend",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "start-frontend",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "webpack:///*": "${webRoot}/*"
            }
        }
    ],
    // The "compounds" section allows you to launch multiple debug configurations at once.
    // "Debug Full Stack" will start both "Debug Backend (Go)" and "Debug Frontend".
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": ["Debug Backend (Go)", "Debug Frontend"]
        }
    ]
}