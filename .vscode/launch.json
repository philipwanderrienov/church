{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend-start",
      "program": "${workspaceFolder}/backend/Church.Api/bin/Debug/net10.0/Church.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/Church.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(http://\\S+)",
        "uriFormat": "%s/index.html",
        "action": "openExternally"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8000"
      }
    },
    {
      "name": "Debug Angular",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "start-frontend",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/frontend/angular-app/src"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": [
        "Debug Backend (.NET)",
        "Debug Angular"
      ]
    }
  ]
}
