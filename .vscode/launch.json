{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend Only",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "frontend-dev",
      "postDebugTask": "frontend-stop",
      "runtimeArgs": [
        "--new-window",
        "--disable-extensions"
      ]
    },
    {
      "name": "Backend Only",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/api",
      "env": {
        "ENV": "development"
      },
      "args": [],
      "showLog": true,
      "trace": "verbose"
    },
    {
      "name": "Frontend + Backend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "start-all",
      "postDebugTask": "stop-all",
      "runtimeArgs": [
        "--new-window",
        "--disable-extensions"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": ["Backend Only", "Frontend Only"],
      "stopAll": true
    }
  ]
}
