{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/Church.Api/bin/Debug/net8.0/Church.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/Church.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger",
        "action": "openExternally"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    },
    {
      "name": "Debug Angular",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "start-angular",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": [
        "Debug Backend (.NET)",
        "Debug Angular"
      ]
    }
  ]
}
