{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend (Go)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/backend/cmd/api",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "GO_ENV": "development"
            },
            "args": [],
            "serverReadyAction": {
                "pattern": "Server starting on .*:8081",
                "uriFormat": "http://localhost:8081/swagger/index.html",
                "action": "openExternally"
            }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "start-frontend",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/frontend/src",
            "sourceMaps": true,
            "trace": true
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": [
                "Debug Backend (Go)",
                "Debug Frontend (Chrome)"
            ]
        }
    ]
}
