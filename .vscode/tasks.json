{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend-dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*ready in.*",
          "endsPattern": "^.*$"
        }
      }
    },
    {
      "label": "frontend-stop",
      "type": "shell",
      "command": "echo",
      "args": ["Frontend stopped"],
      "isBackground": false
    },
    {
      "label": "backend-dev",
      "type": "shell",
      "command": "go",
      "args": ["run", "./cmd/api/main.go"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Server|listening|running.*",
          "endsPattern": "^.*$"
        }
      }
    },
    {
      "label": "start-all",
      "dependsOn": ["backend-dev", "frontend-dev"],
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "stop-all",
      "type": "shell",
      "command": "echo",
      "args": ["All services stopped"],
      "isBackground": false
    }
  ]
}
