{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "backend-start",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "backend/Church.Api/Church.Api.csproj"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "dotnet",
                "pattern": [
                    {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Now listening on:.*"
                }
            }
        },
        {
            "label": "frontend-start",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": ".*(Local|Network):\\s+(https?://\\S+).*",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*ready in.*",
                    "endsPattern": ".*(Local|Network):\\s+(https?://\\S+).*"
                }
            }
        }
    ]
}
